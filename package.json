{
  "name": "dsh-everos-memory",
  "version": "0.5.0",
  "description": "DeepSeek Harness bundle plugin: captures the signal of a session — decisions, the work done, the plan, the deliverables — into EverOS, recalls relevant memory into the turn, and lets you curate it with /everos.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "memory",
    "everos"
  ],
  "engines": {
    "dsh": ">=0.2.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "license": "MIT"
}
